<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_config_snippet_wizard_form" model="ir.ui.view">
        <field name="name">mcp.config.snippet.wizard.form</field>
        <field name="model">mcp.config.snippet.wizard</field>
        <field name="arch" type="xml">
            <form string="Share Connection">
                <sheet>
                    <field name="token_id" invisible="1"/>
                    <group>
                        <field name="server_url" widget="CopyClipboardChar" readonly="1" string="Server URL"/>
                        <field name="token" widget="CopyClipboardChar" readonly="1" string="Access Token"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
