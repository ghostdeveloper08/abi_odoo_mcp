<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_audit_log_list" model="ir.ui.view">
        <field name="name">mcp.audit.log.list</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <tree string="AI Activity Logs" create="false" edit="false" decoration-danger="status == 'error'" decoration-success="status == 'success'">
                <field name="create_date" string="Date &amp; Time"/>
                <field name="user_id" string="User"/>
                <field name="token_id" string="Token"/>
                <field name="tool_name" string="Action / Tool"/>
                <field name="model_name" string="Target Data"/>
                <field name="execution_time_ms" string="Duration (ms)"/>
                <field name="tokens_estimated" string="Est. Tokens"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
                <field name="ip_address" string="Client IP"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_audit_log_form" model="ir.ui.view">
        <field name="name">mcp.audit.log.form</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <form string="AI Activity Log" create="false" edit="false">
                <sheet>
                    <widget name="web_ribbon" title="Error" bg_color="text-bg-danger" invisible="status != 'error'"/>
                    <widget name="web_ribbon" title="Success" bg_color="text-bg-success" invisible="status != 'success'"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Request Details">
                            <field name="create_date" readonly="1" string="Timestamp"/>
                            <field name="user_id" readonly="1" string="User"/>
                            <field name="token_id" readonly="1" string="Access Token"/>
                            <field name="tool_name" readonly="1" string="Action / Tool"/>
                            <field name="model_name" readonly="1" string="Target Data"/>
                        </group>
                        <group string="Performance &amp; Status">
                            <field name="status" readonly="1" string="Status"/>
                            <field name="execution_time_ms" readonly="1" string="Duration (ms)"/>
                            <field name="tokens_estimated" readonly="1" string="Estimated Tokens"/>
                            <field name="ip_address" readonly="1" string="Client IP"/>
                        </group>
                    </group>

                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" readonly="1" class="text-danger font-monospace"/>
                    </group>

                    <notebook>
                        <page string="Request Details" name="request">
                            <field name="request_summary" widget="text" readonly="1" class="font-monospace bg-light p-2"/>
                        </page>
                        <page string="Response Summary" name="response">
                            <field name="response_summary" widget="text" readonly="1" class="font-monospace bg-light p-2"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_audit_log_graph" model="ir.ui.view">
        <field name="name">mcp.audit.log.graph</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <graph string="AI Activity Analytics" type="bar">
                <field name="create_date" interval="day"/>
                <field name="execution_time_ms" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_mcp_audit_log_pivot" model="ir.ui.view">
        <field name="name">mcp.audit.log.pivot</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <pivot string="AI Activity Breakdown">
                <field name="user_id" type="row"/>
                <field name="tool_name" type="col"/>
                <field name="execution_time_ms" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_mcp_audit_log_search" model="ir.ui.view">
        <field name="name">mcp.audit.log.search</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Activity Logs">
                <field name="user_id"/>
                <field name="token_id"/>
                <field name="tool_name"/>
                <field name="model_name"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Errors" name="errors" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Action / Tool" name="group_by_tool" context="{'group_by': 'tool_name'}"/>
                    <filter string="Target Data" name="group_by_model" context="{'group_by': 'model_name'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_audit_log" model="ir.actions.act_window">
        <field name="name">Activity Logs</field>
        <field name="res_model">mcp.audit.log</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_mcp_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI activity recorded yet!
            </p>
            <p>
                When AI assistants execute queries or actions via MCP, the history and duration will appear here.
            </p>
        </field>
    </record>
</odoo>
