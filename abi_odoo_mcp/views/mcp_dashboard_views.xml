<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Assistants Executive Kanban View -->
    <record id="view_mcp_access_token_kanban" model="ir.ui.view">
        <field name="name">mcp.access.token.kanban</field>
        <field name="model">mcp.access.token</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="profile_preset"/>
                <field name="active"/>
                <field name="is_readonly"/>
                <field name="total_calls"/>
                <field name="last_used_at"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column justify-content-between h-100 p-2">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fa fa-robot fs-3 text-primary me-2" title="AI Robot"/>
                                        <h5 class="mb-0 fw-bold"><field name="name"/></h5>
                                    </div>
                                    <t t-if="record.active.raw_value">
                                        <span t-if="!record.is_readonly.raw_value" class="badge rounded-pill text-bg-success">Active</span>
                                        <span t-else="" class="badge rounded-pill text-bg-warning">Read Only</span>
                                    </t>
                                    <span t-else="" class="badge rounded-pill text-bg-danger">Revoked</span>
                                </div>
                                <div class="mb-2">
                                    <span class="badge text-bg-light border text-muted">
                                        <i class="fa fa-briefcase me-1" title="Preset"/>
                                        <field name="profile_preset"/>
                                    </span>
                                </div>
                                <div class="text-muted small mb-2">
                                    <div><i class="fa fa-user me-1" title="User"/> Assigned: <field name="user_id"/></div>
                                    <div><i class="fa fa-clock-o me-1" title="Clock"/> Last Active: <field name="last_used_at"/></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                <div class="fw-bold fs-6 text-dark">
                                    <field name="total_calls"/> <span class="text-muted small fw-normal">requests</span>
                                </div>
                                <div>
                                    <button name="action_open_config_wizard" type="object" class="btn btn-sm btn-primary me-1" title="Share Connection">
                                        <i class="fa fa-share-alt me-1"/> Share
                                    </button>
                                    <button name="action_open_audit_logs" type="object" class="btn btn-sm btn-secondary" title="View Activity Logs">
                                        <i class="fa fa-list"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Executive Overview Dashboard Action -->
    <record id="action_mcp_dashboard" model="ir.actions.act_window">
        <field name="name">AI Assistants Dashboard</field>
        <field name="res_model">mcp.access.token</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_mcp_access_token_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect Your First AI Assistant (Claude, Cursor, ChatGPT)
            </p>
            <p>
                Empower your business with AI. Connect Claude or your preferred LLM to securely query sales, inventory, and invoices in natural language.
            </p>
        </field>
    </record>
</odoo>
