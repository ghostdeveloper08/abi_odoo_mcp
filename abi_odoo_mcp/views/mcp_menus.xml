<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-Level MCP Connector App Menu (Clean, Non-Technical, Generic) -->
    <menuitem id="menu_mcp_root"
              name="MCP Connector"
              web_icon="abi_odoo_mcp,static/description/icon.png"
              sequence="65"
              groups="group_mcp_user,base.group_user"/>

    <!-- 0. AI Assistants Dashboard (Overview) -->
    <menuitem id="menu_mcp_dashboard"
              name="Dashboard"
              parent="menu_mcp_root"
              action="action_mcp_dashboard"
              sequence="5"/>

    <!-- 0b. Custom Dashboards Generated by AI -->
    <menuitem id="menu_mcp_custom_dashboards"
              name="Custom Dashboards"
              parent="menu_mcp_root"
              sequence="8"
              groups="group_mcp_user,base.group_user"/>

    <!-- 1. Access Tokens (Connections & Security) -->
    <menuitem id="menu_mcp_access_token"
              name="Access Tokens"
              parent="menu_mcp_root"
              action="action_mcp_access_token"
              sequence="10"/>

    <!-- 2. Activity / Audit Logs (Telemetry & Observability) -->
    <menuitem id="menu_mcp_audit_log"
              name="Activity Logs"
              parent="menu_mcp_root"
              action="action_mcp_audit_log"
              sequence="20"
              groups="group_mcp_user,base.group_user"/>

    <!-- 3. Configuration & Global Controls -->
    <menuitem id="menu_mcp_configuration"
              name="Configuration"
              parent="menu_mcp_root"
              sequence="30"
              groups="group_mcp_manager,base.group_system"/>

    <menuitem id="menu_mcp_config_settings"
              name="Settings"
              parent="menu_mcp_configuration"
              action="action_mcp_config_settings"
              sequence="10"/>
</odoo>
